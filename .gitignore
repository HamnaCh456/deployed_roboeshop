# --- dependencies -----------------------------------------------------------
node_modules/
build/
.DS_Store
npm-debug.log*

# TypeScript incremental build state. Rewritten on every compile, so a tracked
# copy shows up as a diff in unrelated commits.
.next/
*.tsbuildinfo
# Regenerated by every `next dev` / `next build`.
ui/next-env.d.ts

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# --- scraper outputs (regenerate with `python run.py --from-config`) ---------
# robots.db / robots.json / robots.csv are build artefacts, not source: ~54 MB
# that changes on every crawl. The pipeline recreates them from the live sites.
scraper/data/

# HTTP response cache. ~184 MB of raw vendor HTML, purely a speed optimisation.
scraper/.cache/

# Internet Archive cache for the tutorial pipeline. Same deal: a speed
# optimisation, rebuilt by `python run_tutorials.py`.
scraper/.cache_tutorials/

# SerpAPI results for the assistant's find_video_tutorials tool. A cost
# optimisation (SerpAPI bills per search), rebuilt on demand.
ui/.cache/

# --- local config -----------------------------------------------------------
.env
.env.local
*.local

# Brainstorming mockups from the superpowers visual companion. Session
# scratch, not source.
.superpowers/
